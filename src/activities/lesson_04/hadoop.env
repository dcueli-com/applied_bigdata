CLUSTER_NAME=mt_iabg_hadoop_cluster
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
HDFS_CONF_dfs_replication=2
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
HADOOP_OPTS="-javaagent:/opt/jmx_exporter/jmx_prometheus_javaagent.jar=9010:/opt/jmx_exporter/jmx_config.yml"
# HADOOP_OPTS="-javaagent:/opt/jmx_exporter/jmx_prometheus_javaagent.jar=9010:/opt/jmx_exporter/jmx_config.yml -Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.port=9010 -Dcom.sun.management.jmxremote.rmi.port=9010 -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Djava.rmi.server.hostname=namenode"